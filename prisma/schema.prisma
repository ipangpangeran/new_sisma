generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TahunAjaran {
  id              Int               @id @default(autoincrement())
  tahunAjaran     String            @unique
  status          String            @default("TIDAK_AKTIF") // "AKTIF" | "TIDAK_AKTIF"
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  jenisPembayaran JenisPembayaran[]
  users           User[]
}

model Kelas {
  id         Int      @id @default(autoincrement())
  namaKelas  String   @unique
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  siswa      Siswa[]
}

model Siswa {
  id             Int              @id @default(autoincrement())
  nis            String?          @unique
  nisn           String?          @unique
  namaSiswa      String
  jenisKelamin   String           @default("L") // "L" | "P"
  idKelas        Int
  kelas          Kelas            @relation(fields: [idKelas], references: [id])
  hpSiswa        String?
  hpOrtu         String?
  statusSiswa    String           @default("AKTIF") // "AKTIF" | "LULUS" | "PINDAH" | "ALUMNI"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tagihanBulanan TagihanBulanan[]
  tagihanBebas   TagihanBebas[]
}

model User {
  id                Int                 @id @default(autoincrement())
  username          String              @unique
  password          String
  namaLengkap       String
  level             String              @default("bendahara") // "admin" | "bendahara" | "siswa"
  idTahunAjaran     Int?
  tahunAjaran       TahunAjaran?        @relation(fields: [idTahunAjaran], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pembayaranBulanan PembayaranBulanan[]
  pembayaranBebas   PembayaranBebas[]
  kas               Kas[]
}

model PosBayar {
  id              Int               @id @default(autoincrement())
  namaPosBayar    String            @unique
  keterangan      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  jenisPembayaran JenisPembayaran[]
  kas             Kas[]
}

model JenisPembayaran {
  id             Int              @id @default(autoincrement())
  idPosBayar     Int
  posBayar       PosBayar         @relation(fields: [idPosBayar], references: [id])
  idTahunAjaran  Int
  tahunAjaran    TahunAjaran      @relation(fields: [idTahunAjaran], references: [id])
  tipeBayar      String           @default("bulanan") // "bulanan" | "bebas"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tagihanBulanan TagihanBulanan[]
  tagihanBebas   TagihanBebas[]
}

model TagihanBulanan {
  id                Int                 @id @default(autoincrement())
  idJenisPembayaran Int
  jenisPembayaran   JenisPembayaran     @relation(fields: [idJenisPembayaran], references: [id], onDelete: Cascade)
  idSiswa           Int
  siswa             Siswa               @relation(fields: [idSiswa], references: [id], onDelete: Cascade)
  bulan             String              // "Juli", "Agustus", ..., "Juni"
  urutanBulan       Int                 // 1 .. 12
  tarif             Float               @default(0)
  statusBayar       String              @default("BELUM_BAYAR") // "BELUM_BAYAR" | "LUNAS"
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pembayaranBulanan PembayaranBulanan[]

  @@unique([idJenisPembayaran, idSiswa, urutanBulan])
}

model PembayaranBulanan {
  id               Int            @id @default(autoincrement())
  idTagihanBulanan Int
  tagihanBulanan   TagihanBulanan @relation(fields: [idTagihanBulanan], references: [id], onDelete: Cascade)
  tglBayar         DateTime       @default(now())
  jumlahBayar      Float
  idUser           Int
  user             User           @relation(fields: [idUser], references: [id])
  noRef            String         @unique
  createdAt        DateTime       @default(now())
}

model TagihanBebas {
  id                Int               @id @default(autoincrement())
  idJenisPembayaran Int
  jenisPembayaran   JenisPembayaran   @relation(fields: [idJenisPembayaran], references: [id], onDelete: Cascade)
  idSiswa           Int
  siswa             Siswa             @relation(fields: [idSiswa], references: [id], onDelete: Cascade)
  totalTagihan      Float             @default(0)
  terbayar          Float             @default(0)
  statusBayar       String            @default("BELUM_LUNAS") // "BELUM_LUNAS" | "LUNAS"
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  pembayaranBebas   PembayaranBebas[]

  @@unique([idJenisPembayaran, idSiswa])
}

model PembayaranBebas {
  id             Int          @id @default(autoincrement())
  idTagihanBebas Int
  tagihanBebas   TagihanBebas @relation(fields: [idTagihanBebas], references: [id], onDelete: Cascade)
  tglBayar       DateTime     @default(now())
  jumlahBayar    Float
  keterangan     String?
  idUser         Int
  user           User         @relation(fields: [idUser], references: [id])
  noRef          String       @unique
  createdAt      DateTime     @default(now())
}

model Kas {
  id          Int       @id @default(autoincrement())
  tgl         DateTime  @default(now())
  uraian      String
  pemasukan   Float     @default(0)
  pengeluaran Float     @default(0)
  jenis       String    // "masuk" | "keluar"
  idUser      Int
  user        User      @relation(fields: [idUser], references: [id])
  idPosBayar  Int?
  posBayar    PosBayar? @relation(fields: [idPosBayar], references: [id])
  createdAt   DateTime  @default(now())
}

model Pengaturan {
  id                   Int      @id @default(1)
  namaSekolah          String   @default("SMA Swasta Persiapan Stabat")
  npsn                 String   @default("10201234")
  alamat               String   @default("Jl. KH. Zainul Arifin No. 12, Stabat")
  telepon              String   @default("(061) 8912345")
  email                String   @default("mail@dev.spp-smapersiapan.web.id")
  website              String   @default("https://dev.spp-smapersiapan.web.id")
  kepalaSekolah        String   @default("Drs. H. Ahmad Dahlan, M.Pd")
  nipKepalaSekolah     String   @default("19680512 199303 1 004")
  bendahara            String   @default("Siti Rahmah, S.Pd")
  nipBendahara         String   @default("19750820 200212 2 001")
  updatedAt            DateTime @updatedAt
}
